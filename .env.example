# ===== ホスト側公開ポート =====
LLM_PORT=11434
TTS_PORT=50021
RENDERER_PORT=3100

# ===== LLM (Ollama) =====
# 小型・高速モデル推奨。llama3.2:3b / mistral:7b / qwen2.5:3b など
OLLAMA_MODEL=qwen2.5:7b-instruct
# コンテナ内から参照するベースURL（orchestrator用）
OLLAMA_BASE_URL=http://llm:11434

# ===== TTS (VOICEVOX Engine) =====
VOICEVOX_BASE_URL=http://tts:50021
# 話者ID（春日部つむぎ ノーマル=8, ずんだもん ノーマル=3, 四国めたん ノーマル=0 など）
VOICEVOX_SPEAKER=8
# ナレーション速度（VOICEVOX speedScale）
VOICEVOX_SPEED=1.4
# VOICEVOX は CPU 版イメージ。GPU 版は cuda イメージに変更
VOICEVOX_IMAGE=voicevox/voicevox_engine:cpu-ubuntu20.04-latest

# ===== 動画設定 =====
VIDEO_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
# 目標尺（分）。チャプター数とセリフ数の目安計算に使用
TARGET_DURATION_MIN=10
# チャプター数（5〜8推奨）
CHAPTER_COUNT=6
# 1セリフ間のポーズ（秒）
SENTENCE_GAP_SEC=0.35

# ===== キャラクター立ち絵 =====
# shared-data からの相対パスをカンマ区切り（1枚目=基本, 2枚目=ウインク差分）。未配置なら立ち絵なし
CHARACTER_IMAGES=characters/tsumugi-1.png
# description.txt に自動付記するクレジット（VOICEVOXキャラクター利用規約対応）
CHARACTER_CREDIT=VOICEVOX:春日部つむぎ / 立ち絵=春日部つくし

# 固定テーマカラー（rgb(255,52,52) = #ff3434）。空ならジョブごとにランダム色相
ACCENT_COLOR=#ff3434
# プログレスバーのグラデーション2色目（空なら自動で明るい色を生成）
ACCENT_COLOR2=

# ===== BGM =====
# LLMが mood を返さない場合・モック時のフォールバックムード
# （shared-data/bgm/library.json の mood タグと照合）
BGM_MOOD=calm
# BGM の基準音量（0.0〜1.0。ダッキングでさらに自動で絞られる）
BGM_VOLUME=0.22

# 背景スタイル（game=手続き生成ゲーム風背景 / none=なし）
BG_STYLE=game

# ===== Remotion レンダリング =====
# Chromium 同時レンダリングスレッド数（メモリと相談。OOMなら1に）
RENDER_CONCURRENCY=2

# ===== Orchestrator =====
# 起動時に自動でジョブを走らせるか（検証用）
RUN_ON_STARTUP=false
# true なら LLM を呼ばずモックスクリプトで動作検証（TTS/Remotion/結合は実施）
MOCK_PIPELINE=true
# モック時の1チャプターあたりセリフ数（6文×6章 ≒ 2〜3分の検証用動画）
MOCK_SENTENCES_PER_CHAPTER=6
# LLM事実検証フェーズ（各章の数値・固有名詞をLLMで再確認。falseで無効）
FACT_CHECK=true
JOB_TOPIC=大規模言語モデルの仕組み

# ===== YouTube アップロード =====
# true にすると完了後に自動アップロード（既定: 非公開）
YT_UPLOAD=false
YT_PRIVACY=private
# カテゴリID（27=Education）
YT_CATEGORY_ID=27
# OAuth 2.0 認証情報（get_refresh_token.py で初回取得）
# スコープ: https://www.googleapis.com/auth/youtube.upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
